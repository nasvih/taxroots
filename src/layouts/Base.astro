---
// Base layout. SHARED CONTRACT — page agents must NOT edit.
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource-variable/inter';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/motion.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props { title: string; description: string; image?: string; imageAlt?: string; noindex?: boolean; jsonld?: object | object[]; article?: { published: string; modified?: string; section?: string } }
const { title, description, image = '/og.jpg', imageAlt = 'TaxRoots: Irish tax refunds. Get more back.', noindex = false, jsonld, article } = Astro.props;
const ogImage = new URL(image, SITE.url).href;
const isDefaultOg = image === '/og.jpg';
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const fullTitle = title.includes('TaxRoots') ? title : `${title} | TaxRoots`;
// Only confirmed facts here: no email, street address, hours, prices, ratings or sameAs until the owner confirms them.
const org = {
  '@context': 'https://schema.org', '@type': 'AccountingService', '@id': `${SITE.url}/#org`,
  name: SITE.legal, legalName: SITE.legal, alternateName: SITE.name, url: `${SITE.url}/`,
  logo: { '@type': 'ImageObject', url: `${SITE.url}/icon-512.png`, width: 512, height: 512 },
  image: `${SITE.url}/og.jpg`, slogan: SITE.tagline,
  description: 'TaxRoots Limited is a Dublin company that helps PAYE workers in Ireland claim back overpaid tax from Revenue: tax credits, reliefs and refunds for every open year.',
  telephone: SITE.phone.replace(/\s/g, ''),
  contactPoint: { '@type': 'ContactPoint', telephone: SITE.phone.replace(/\s/g, ''), contactType: 'customer service', areaServed: 'IE', availableLanguage: 'en' },
  areaServed: { '@type': 'Country', name: 'Ireland', identifier: 'IE' },
  address: { '@type': 'PostalAddress', addressLocality: 'Dublin', addressCountry: 'IE' },
  identifier: { '@type': 'PropertyValue', propertyID: 'CRO', value: SITE.cro }, foundingDate: SITE.incorporated,
  knowsAbout: ['PAYE tax refunds', 'Irish tax credits', 'Rent Tax Credit', 'Medical expenses tax relief', 'Remote Working Relief', 'Flat rate expenses', 'Tuition fees tax relief', 'Emergency tax'],
};
const isHome = Astro.url.pathname === '/';
const website = { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${SITE.url}/#website`, url: `${SITE.url}/`, name: SITE.name, alternateName: SITE.legal, inLanguage: 'en-IE', publisher: { '@id': `${SITE.url}/#org` } };
const ld = [org, ...(isHome ? [website] : []), ...(jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [])];
---
<!doctype html>
<html lang="en-IE">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
  <meta name="theme-color" content="#322783" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:site_name" content="TaxRoots" />
  <meta property="og:locale" content="en_IE" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  {isDefaultOg && <meta property="og:image:width" content="1200" />}
  {isDefaultOg && <meta property="og:image:height" content="630" />}
  <meta property="og:image:alt" content={imageAlt} />
  {article && <meta property="article:published_time" content={article.published} />}
  {article?.modified && <meta property="article:modified_time" content={article.modified} />}
  {article?.section && <meta property="article:section" content={article.section} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={imageAlt} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  {ld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <Header />
  <main id="main"><slot /></main>
  <Footer />
  <script>import '../scripts/motion';</script>
</body>
</html>
