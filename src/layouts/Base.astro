---
// Base layout. SHARED CONTRACT — page agents must NOT edit.
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource-variable/inter';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/motion.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props { title: string; description: string; image?: string; noindex?: boolean; jsonld?: object | object[] }
const { title, description, image = '/og.jpg', noindex = false, jsonld } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const fullTitle = title.includes('TaxRoots') ? title : `${title} | TaxRoots`;
const org = {
  '@context': 'https://schema.org', '@type': 'AccountingService', name: SITE.legal, alternateName: SITE.name,
  url: SITE.url, logo: `${SITE.url}/icon-512.png`, slogan: 'Get more back', areaServed: 'IE',
  address: { '@type': 'PostalAddress', addressLocality: 'Dublin', addressCountry: 'IE' },
  identifier: { '@type': 'PropertyValue', propertyID: 'CRO', value: SITE.cro }, foundingDate: SITE.incorporated,
};
const ld = [org, ...(jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [])];
---
<!doctype html>
<html lang="en-IE">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content="#322783" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="TaxRoots" />
  <meta property="og:locale" content="en_IE" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(image, SITE.url).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  {ld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <Header />
  <main id="main"><slot /></main>
  <Footer />
  <script>import '../scripts/motion';</script>
</body>
</html>
