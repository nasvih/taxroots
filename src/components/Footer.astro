---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { SITE, FOOTER, CTA, OFFICES } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="wrap">
    <div class="ftr-card dark">
      <div class="top">
        <div class="say">
          <h2 class="split">Let's get your <span class="hl">money back.</span></h2>
          <p class="rv">Four years of unclaimed tax credits and reliefs could be sitting with Revenue right now. We find them, file them and keep you posted.</p>
          <div class="btns rv" data-delay="120">
            <Button href={CTA.href} variant="green">{CTA.label}</Button>
          </div>
        </div>
        <div class="offs stg" aria-label="Our offices">
          {OFFICES.map((o) => (
            <address class="off">
              <h3>{o.name}</h3>
              {o.address && <p class="adr">{o.address}</p>}
              <ul class="off-ct">
                <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
                {o.phones.map((p) => <li><a href={p.href}>{p.number}</a></li>)}
              </ul>
            </address>
          ))}
        </div>
      </div>
      <div class="bottom">
        <Logo tone="dark" height={58} />
        <p class="legal">{SITE.legal} is a private company limited by shares, registered in Ireland. Company number (CRO) {SITE.cro}. Registered office: {SITE.address}.<br />TaxRoots is an independent company, not part of or endorsed by the Revenue Commissioners. You can claim credits and reliefs yourself, free of charge, through Revenue's myAccount. Information on this site is general guidance, not advice on your own circumstances. Figures last checked 24 November 2026.</p>
        <ul class="lg">
          {FOOTER.legal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          <li><span>© {year} {SITE.legal}</span></li>
        </ul>
      </div>
    </div>
  </div>
</footer>

<a class="wa-fab" href={SITE.whatsapp} target="_blank" rel="noopener" aria-label="Chat with TaxRoots on WhatsApp">
  <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.4.1-.2 0-.3 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2c0 1.3.9 2.5 1.1 2.7.1.2 1.8 2.8 4.4 3.9 1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.7-.5Z"/></svg>
  <span>WhatsApp us</span>
</a>
<style>
  .wa-fab{position:fixed;right:clamp(14px,2vw,24px);bottom:clamp(14px,2vw,24px);z-index:90;display:inline-flex;align-items:center;gap:10px;height:56px;padding:0 20px 0 16px;border-radius:var(--r-pill);background:var(--green);color:#fff;font:600 var(--fs-sm)/1 var(--f-display);text-decoration:none;box-shadow:var(--sh-2);transition:background .2s,transform .3s var(--ease-out)}
  .wa-fab:hover{background:var(--green-700);transform:translateY(-2px)}
  .wa-fab svg{width:26px;height:26px}
  @media (max-width:640px){.wa-fab{width:56px;padding:0;justify-content:center}.wa-fab span{display:none}}
</style>

<style>
  .ftr{padding:clamp(10px,1.6vw,24px) 0 clamp(12px,2vw,24px)}
  .ftr>.wrap{max-width:calc(var(--wrap) + 160px);padding-inline:clamp(10px,1.6vw,24px)}
  .ftr-card{border-radius:var(--r-xl);padding:clamp(40px,6vw,88px) clamp(24px,5vw,80px) clamp(28px,3vw,40px)}
  .top{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:clamp(40px,6vw,96px);align-items:end;padding-bottom:clamp(40px,5vw,72px);border-bottom:1px solid var(--line-dark)}
  .say h2{font-size:var(--fs-display);line-height:1.04;letter-spacing:-.03em;margin-bottom:var(--s5)}
  .say p{max-width:46ch;margin-bottom:var(--s6)}
  .offs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--s4)}
  .off{font-style:normal;padding:clamp(20px,2vw,28px);border-radius:var(--r-lg);background:rgba(255,255,255,.06);border:1px solid var(--line-dark);display:flex;flex-direction:column}
  .off h3{display:flex;align-items:center;gap:10px;font:600 1.15rem/1.2 var(--f-display);color:#fff;margin-bottom:12px}
  .off h3::before{content:"";width:10px;height:10px;border-radius:3px;background:var(--green-bright);flex:none}
  .off .adr{margin:0 0 16px;font-size:var(--fs-sm);line-height:1.55;color:var(--on-dark-2)}
  .off-ct{list-style:none;margin:auto 0 0;padding:14px 0 0;border-top:1px solid var(--line-dark);display:grid;gap:6px}
  .off-ct a{color:#fff;font-size:var(--fs-sm);font-weight:600;text-decoration:none;font-variant-numeric:tabular-nums;white-space:nowrap;transition:color .2s}
  .off-ct li:first-child a{font-weight:500;color:var(--on-dark-2)}
  .off-ct a:hover{color:var(--green-bright)}
  .lg{list-style:none;margin:0;padding:0}
  .lg a{color:var(--on-dark-2);text-decoration:none;font-size:var(--fs-sm);transition:color .2s}
  .lg a:hover{color:var(--green-bright)}
  .bottom{display:grid;grid-template-columns:auto 1fr;align-items:start;gap:var(--s5) var(--s7);padding-top:var(--s6)}
  .bottom .lg{grid-column:1/-1}
  .legal{margin:0;font-size:var(--fs-xs);line-height:1.6;color:var(--on-dark-2);max-width:70ch}
  .lg{display:flex;flex-wrap:wrap;gap:6px 18px;font-size:var(--fs-xs)}
  .lg span{color:var(--on-dark-2)}
  @media (max-width:1000px){.top{grid-template-columns:1fr;align-items:start}.bottom{grid-template-columns:1fr}}
  @media (max-width:560px){.offs{grid-template-columns:1fr}}
</style>
