---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { SITE, FOOTER, SERVICE_LINKS, CTA } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="wrap">
    <div class="ftr-card dark">
      <div class="top">
        <div class="say">
          <h2 class="split">Let's get your <span class="hl">money back.</span></h2>
          <p class="rv">Four years of unclaimed tax credits and reliefs could be sitting with Revenue right now. We find them, file them and keep you posted.</p>
          <div class="btns rv" data-delay="120">
            <Button href={CTA.href} variant="green">{CTA.label}</Button>
            <Button href="/refund-estimator/" variant="ghost">Estimate my refund</Button>
          </div>
        </div>
        <div class="cols">
          <div>
            <h3>Services</h3>
            <ul>{SERVICE_LINKS.slice(0, 7).map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
          </div>
          <div>
            <h3>Company</h3>
            <ul>{FOOTER.company.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
          </div>
          <div>
            <h3>Help</h3>
            <ul>{FOOTER.help.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
            <h3 class="mt">Talk to us</h3>
            <ul>
              <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
              <li><a href={SITE.phoneHref}>{SITE.phone}</a></li>
            </ul>
          </div>
        </div>
      </div>
      <div class="bottom">
        <Logo tone="dark" height={36} />
        <p class="legal">{SITE.legal} is a private company limited by shares, registered in Ireland. Company number (CRO) {SITE.cro}. {SITE.address}.<br />TaxRoots is an independent company, not part of or endorsed by the Revenue Commissioners. You can claim credits and reliefs yourself, free of charge, through Revenue's myAccount. Information on this site is general guidance, not advice on your own circumstances. Figures last checked 30 October 2026.</p>
        <ul class="lg">
          {FOOTER.legal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          <li><span>© {year} {SITE.legal}</span></li>
        </ul>
      </div>
    </div>
  </div>
</footer>

<a class="wa-fab" href={SITE.whatsapp} target="_blank" rel="noopener" aria-label="Chat with TaxRoots on WhatsApp">
  <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.4.1-.2 0-.3 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2c0 1.3.9 2.5 1.1 2.7.1.2 1.8 2.8 4.4 3.9 1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.7-.5Z"/></svg>
  <span>WhatsApp us</span>
</a>
<style>
  .wa-fab{position:fixed;right:clamp(14px,2vw,24px);bottom:clamp(14px,2vw,24px);z-index:90;display:inline-flex;align-items:center;gap:10px;height:56px;padding:0 20px 0 16px;border-radius:var(--r-pill);background:var(--green);color:#fff;font:600 var(--fs-sm)/1 var(--f-display);text-decoration:none;box-shadow:var(--sh-2);transition:background .2s,transform .3s var(--ease-out)}
  .wa-fab:hover{background:var(--green-700);transform:translateY(-2px)}
  .wa-fab svg{width:26px;height:26px}
  @media (max-width:640px){.wa-fab{width:56px;padding:0;justify-content:center}.wa-fab span{display:none}}
</style>

<style>
  .ftr{padding:0 0 clamp(12px,2vw,24px)}
  .ftr>.wrap{max-width:calc(var(--wrap) + 160px);padding-inline:clamp(10px,1.6vw,24px)}
  .ftr-card{border-radius:var(--r-xl);padding:clamp(40px,6vw,88px) clamp(24px,5vw,80px) clamp(28px,3vw,40px)}
  .top{display:grid;grid-template-columns:1.05fr 1fr;gap:clamp(40px,6vw,96px);padding-bottom:clamp(40px,5vw,72px);border-bottom:1px solid var(--line-dark)}
  .say h2{font-size:var(--fs-display);line-height:1.04;letter-spacing:-.03em;margin-bottom:var(--s5)}
  .say p{max-width:46ch;margin-bottom:var(--s6)}
  .cols{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--s5)}
  .cols h3{font:600 1rem/1.2 var(--f-display);color:#fff;margin-bottom:var(--s4)}
  .cols h3.mt{margin-top:var(--s6)}
  .cols ul,.lg{list-style:none;margin:0;padding:0}
  .cols li{margin-bottom:10px}
  .cols a,.lg a{color:var(--on-dark-2);text-decoration:none;font-size:var(--fs-sm);transition:color .2s}
  .cols a:hover,.lg a:hover{color:var(--green-bright)}
  .bottom{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:var(--s6);padding-top:var(--s6)}
  .legal{margin:0;font-size:var(--fs-xs);line-height:1.6;color:var(--on-dark-2);max-width:70ch}
  .lg{display:flex;flex-wrap:wrap;gap:6px 18px;font-size:var(--fs-xs)}
  .lg span{color:var(--on-dark-2)}
  @media (max-width:1000px){.top{grid-template-columns:1fr}.bottom{grid-template-columns:1fr}}
  @media (max-width:560px){.cols{grid-template-columns:1fr 1fr}}
</style>
