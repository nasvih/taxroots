---
// Full logo lockup: icon + TaxRoots wordmark + GET MORE BACK tagline, from the client's official vector
// (files/brand/TaxRoots-logo-official.pdf, 2026-11-17). The *-lockup.svg files are the same art with the tagline
// glyphs enlarged and re-tracked under the wordmark so the tagline stays readable at header/footer sizes
// (the official file's tagline is ~5px tall at 40px). Generated by re-positioning the PDF's own glyphs; nothing redrawn.
// tone: 'color' (white bg) | 'dark' (indigo bg) | 'white'
const { tone = 'color', height = 44, class: cls = '', link = true } = Astro.props;
// Source art viewBox 716:170.
const w = Math.round(height * 716 / 170);
const Tag = link ? 'a' : 'span';
---
<Tag href={link ? '/' : undefined} class:list={['logo', cls]} aria-label={link ? 'TaxRoots: Get More Back. Home' : undefined}>
  <img src={`/brand/logo-${tone}-lockup.svg`} width={w} height={height} alt="TaxRoots: Get More Back" style={`height:${height}px;width:auto`} decoding="async" fetchpriority="high" />
</Tag>
<style>
  .logo{display:inline-flex;align-items:center;text-decoration:none;flex:none}
  .logo img{max-width:100%}
</style>
