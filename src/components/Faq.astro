---
// Accordion FAQ + FAQPage JSON-LD. items: {q, a}[] (a may contain simple HTML).
interface Props { items: { q: string; a: string }[]; ld?: boolean }
const { items, ld = true } = Astro.props;
const json = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a.replace(/<[^>]+>/g, '') } })) };
---
<div class="faq stg">
  {items.map((i) => (
    <details>
      <summary><span>{i.q}</span><i aria-hidden="true"></i></summary>
      <div class="a"><p set:html={i.a} /></div>
    </details>
  ))}
</div>
{ld && <script type="application/ld+json" set:html={JSON.stringify(json)} />}
<style>
  .faq{display:grid;gap:12px}
  details{background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);transition:border-color .25s,box-shadow .25s}
  details[open]{border-color:var(--indigo-100);box-shadow:var(--sh-1)}
  summary{display:flex;align-items:center;justify-content:space-between;gap:var(--s5);padding:22px 24px;cursor:pointer;list-style:none;font:600 clamp(1.02rem,1rem + .2vw,1.15rem)/1.35 var(--f-display);color:var(--ink)}
  summary::-webkit-details-marker{display:none}
  summary i{position:relative;flex:none;width:36px;height:36px;border-radius:50%;background:var(--indigo-50);transition:background .25s,transform .4s var(--ease-out)}
  summary i::before,summary i::after{content:"";position:absolute;left:50%;top:50%;width:14px;height:2px;background:var(--indigo);translate:-50% -50%;border-radius:2px}
  summary i::after{rotate:90deg;transition:rotate .4s var(--ease-out)}
  details[open] summary i{background:var(--green)}
  details[open] summary i::before,details[open] summary i::after{background:#fff}
  details[open] summary i::after{rotate:0deg}
  .a{padding:0 24px 22px;max-width:75ch}
  .a p{margin:0}
  .a :global(a){color:var(--indigo)}
</style>
