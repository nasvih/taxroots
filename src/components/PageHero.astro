---
// Inner-page hero: crumbs, tag, split H1, lede, optional buttons slot + optional photo.
interface Props { title: string; lede?: string; tag?: string; crumbs?: { label: string; href?: string }[]; photo?: string; alt?: string }
const { title, lede, tag, crumbs = [], photo, alt = '' } = Astro.props;
const ld = crumbs.length ? { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ label: 'Home', href: '/' }, ...crumbs].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label, ...(c.href ? { item: new URL(c.href, 'https://taxrootsirl.com').href } : {}) })) } : null;
---
<section class:list={['ph', { 'has-photo': photo }]}>
  <div class="wrap ph-in">
    <div class="ph-copy">
      {crumbs.length > 0 && (
        <ol class="crumbs"><li><a href="/">Home</a></li>{crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}</ol>
      )}
      {tag && <p class="tag rv">{tag}</p>}
      <h1 class="split">{title}</h1>
      {lede && <p class="lede rv" data-delay="200">{lede}</p>}
      <div class="rv ph-slot" data-delay="320"><slot /></div>
    </div>
    {photo && <figure class="pic rv rv-c ph-pic" data-delay="150"><img src={`/photos/${photo}`} alt={alt} loading="eager" /></figure>}
  </div>
</section>
{ld && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
<style>
  .ph{padding:clamp(48px,6vw,96px) 0 clamp(40px,5vw,80px)}
  .ph-in{display:grid;gap:clamp(32px,5vw,72px);align-items:center}
  .has-photo .ph-in{grid-template-columns:1.1fr .9fr}
  .tag{margin:0 0 var(--s5)}
  h1{font-size:var(--fs-display);line-height:1.04;letter-spacing:-.03em;max-width:18ch}
  .lede{margin-top:var(--s5)}
  .ph-slot:empty{display:none}
  .ph-slot{margin-top:var(--s6)}
  .ph-pic{aspect-ratio:5/4;border-radius:var(--r-xl)}
  @media (max-width:900px){.has-photo .ph-in{grid-template-columns:1fr}}
</style>
