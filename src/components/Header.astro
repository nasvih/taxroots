---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { NAV, CTA, SITE } from '../data/site';
const path = Astro.url.pathname;
// Only Insights is a real page; the rest are anchors on the home page (scroll-spy marks them there).
const active = (href: string) => !href.includes('#') && path.startsWith(href);
---
<div class="progress" aria-hidden="true"></div>
<header class="site-header">
  <div class="hd wrap">
    <div class="bar">
      <Logo height={50} class="hd-logo" />
      <nav class="nav" aria-label="Main">
        <ul>
          {NAV.map((l) => <li><a href={l.href} class:list={['nl', { on: active(l.href) }]} aria-current={active(l.href) ? 'page' : undefined}>{l.label}</a></li>)}
        </ul>
      </nav>
      <div class="end">
        <Button href={CTA.href} variant="green" size="sm" class="cta">{CTA.label}</Button>
        <button class="burger" type="button" aria-expanded="false" aria-controls="mnav" aria-label="Open menu"><span></span><span></span></button>
      </div>
    </div>
  </div>
  <div id="mnav" class="mnav" hidden>
    <div class="wrap">
      <ul class="m-main">
        {NAV.map((l, i) => <li style={`--i:${i}`}><a href={l.href} class:list={{ on: active(l.href) }}>{l.label}</a></li>)}
      </ul>
      <div class="m-cta"><Button href={CTA.href} variant="green">{CTA.label}</Button></div>
      <div class="m-foot"><Logo height={44} link={false} /><p class="muted m-legal">{SITE.legal} · CRO {SITE.cro}</p></div>
    </div>
  </div>
</header>

<style>
  .site-header{position:sticky;top:0;z-index:100;padding-top:12px;transition:transform .45s var(--ease-out)}
  .site-header.hide{transform:translateY(-110%)}
  .bar{display:flex;align-items:center;gap:var(--s5);height:var(--header-h);padding:0 10px 0 22px;background:rgba(255,255,255,.92);backdrop-filter:saturate(1.4) blur(14px);-webkit-backdrop-filter:saturate(1.4) blur(14px);border:1px solid var(--line);border-radius:var(--r-pill);transition:box-shadow .3s}
  .scrolled .bar{box-shadow:var(--sh-2)}
  .nav{margin-inline:auto}
  .nav>ul{display:flex;gap:2px;list-style:none;margin:0;padding:0}
  .nl{display:inline-flex;align-items:center;gap:6px;height:44px;padding:0 14px;white-space:nowrap;border-radius:var(--r-pill);font:500 .95rem/1 var(--f-display);color:var(--ink);text-decoration:none;transition:background .2s,color .2s}
  .nl:hover{background:var(--indigo-50);color:var(--indigo)}
  .nl.on{color:var(--indigo);box-shadow:inset 0 -2px 0 var(--green)}
  .end{display:flex;align-items:center;gap:6px}
  /* Burger + mobile */
  .burger{display:none;width:48px;height:48px;border:0;border-radius:50%;background:var(--indigo);cursor:pointer;position:relative}
  .burger span{position:absolute;left:15px;right:15px;height:2px;background:#fff;border-radius:2px;transition:transform .35s var(--ease-out)}
  .burger span:first-child{top:19px}.burger span:last-child{top:27px}
  .open .burger span:first-child{transform:translateY(4px) rotate(45deg)}
  .open .burger span:last-child{transform:translateY(-4px) rotate(-45deg)}
  .mnav{position:fixed;inset:calc(var(--header-h) + 24px) 0 0;background:#fff;overflow:auto;padding:var(--s5) 0 var(--s8);border-top:1px solid var(--line)}
  .m-main{list-style:none;margin:0;padding:0}
  .m-main a{display:flex;align-items:center;justify-content:space-between;padding:14px 0;font:600 1.6rem/1.2 var(--f-display);color:var(--ink);text-decoration:none;border-bottom:1px solid var(--line);transition:color .2s}
  .m-main a::after{content:"";width:10px;height:10px;border-top:2px solid currentColor;border-right:2px solid currentColor;transform:rotate(45deg);opacity:.35;transition:opacity .2s,transform .3s var(--ease-out)}
  .m-main a:hover,.m-main a.on{color:var(--indigo)}
  .m-main a:hover::after,.m-main a.on::after{opacity:1;transform:translateX(4px) rotate(45deg)}
  :global(html.mo) .open .m-main li{animation:m-in .5s var(--ease-out) both;animation-delay:calc(var(--i) * 45ms)}
  @keyframes m-in{from{opacity:0;transform:translateY(14px)}}
  .m-cta{margin-top:var(--s6)}
  .m-foot{margin-top:var(--s7);padding-top:var(--s5);border-top:1px solid var(--line);display:grid;gap:10px;justify-items:start}
  .m-legal{margin:0;font-size:var(--fs-xs)}
  @media (max-width:1480px){.nl{padding:0 12px}.bar :global(.hd-logo img){height:46px!important}}
  @media (max-width:1300px){.nl{padding:0 11px}}
  @media (max-width:1000px){
    .nav{display:none}
    .end{margin-left:auto}
    .burger{display:block}
    .bar{padding-right:8px;padding-left:18px}
  }
  @media (max-width:520px){.end :global(.cta){display:none}.bar{height:64px}:root{--header-h:64px}.bar :global(.hd-logo img){height:42px!important}}
</style>

<script>
  const h = document.querySelector<HTMLElement>('.site-header')!;
  const b = h.querySelector<HTMLButtonElement>('.burger')!;
  const m = document.getElementById('mnav')!;
  const lenis = () => (window as any).__lenis as { stop(): void; start(): void; scrollTo(t: HTMLElement | number, o?: object): void } | undefined;
  const isOpen = () => h.classList.contains('open');
  const set = (open: boolean) => {
    if (open === isOpen()) return;
    h.classList.toggle('open', open); h.classList.remove('hide');
    b.setAttribute('aria-expanded', String(open));
    b.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    m.hidden = !open; document.body.style.overflow = open ? 'hidden' : '';
    const l = lenis(); if (l) open ? l.stop() : l.start();
    if (!open && m.contains(document.activeElement)) b.focus();
  };
  b.addEventListener('click', () => set(!isOpen()));
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && isOpen()) set(false); });
  matchMedia('(min-width:1001px)').addEventListener('change', (e) => e.matches && set(false));

  // Same-page anchors ("/#services" etc.): on the home page, scroll smoothly (Lenis) with room for the
  // sticky header instead of reloading. From other pages the browser simply navigates to /#x.
  const onHome = location.pathname === '/';
  const OFFSET = 0; // Lenis already honours html scroll-padding-top (header height + 16px)
  const go = (id: string, instant = false) => {
    const el = document.getElementById(id);
    if (!el) return false;
    const l = lenis();
    if (l) l.scrollTo(el, { offset: OFFSET, immediate: instant, lock: !instant });
    else el.scrollIntoView({ behavior: instant || matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    return true;
  };
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href]');
    if (!a || e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
    const url = new URL(a.href, location.href);
    const wasOpen = isOpen();
    if (url.origin === location.origin && url.pathname === location.pathname && url.hash.length > 1) {
      e.preventDefault();
      set(false);
      // wait a frame so Lenis has restarted after the menu closed
      requestAnimationFrame(() => go(decodeURIComponent(url.hash.slice(1))));
      if (onHome) history.pushState(null, '', url.hash);
    } else if (wasOpen) set(false);
  }, true);
  // Arriving with a hash (e.g. /#faq from an insight page): settle on the target once images have laid out.
  if (onHome && location.hash.length > 1) {
    addEventListener('load', () => setTimeout(() => go(decodeURIComponent(location.hash.slice(1)), true), 60));
  }

  // Scroll-spy: underline the nav item for the section in view (home page only).
  if (onHome) {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav a.nl, .m-main a')).filter((a) => a.getAttribute('href')!.startsWith('/#'));
    const ids = [...new Set(links.map((a) => a.getAttribute('href')!.slice(2)))];
    const secs = ids.map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
    const mark = () => {
      const y = innerHeight * 0.35;
      let cur = '';
      for (const s of secs) { const r = s.getBoundingClientRect(); if (r.top <= y && r.bottom > y) cur = s.id; }
      links.forEach((a) => a.classList.toggle('on', a.getAttribute('href') === '/#' + cur));
    };
    addEventListener('scroll', mark, { passive: true }); mark();
  }
</script>
