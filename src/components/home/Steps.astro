---
import Button from '../Button.astro';
import { CTA } from '../../data/site';
const steps = [
  { t: 'Tell us about you', d: 'Fill in our short online form with your name, PPSN, contact details and the costs you’ve had, such as rent, medical bills, college fees or working from home. We never ask for your myAccount password.', p: 'about-coffee-notebook.jpg', alt: 'Open notebook and pen beside a latte on a wooden desk' },
  { t: 'Link us to your Revenue record', d: 'We ask Revenue to let us act as your tax agent. You approve it in myAccount under MyEnquiries, or sign Form PAYE A1 if you don’t use myAccount. That lets us see your record and file for you.', p: 'about-laptop-documents.jpg', alt: 'Laptop on a white desk with documents and a coffee cup' },
  { t: 'We review and claim', d: 'We check every year still open, currently 2022 to 2025, match your costs to the credits and reliefs you qualify for and file the returns. If a year could show tax owed, we tell you first and only file it with your OK.', p: 'about-calculator-paperwork.jpg', alt: 'Calculator and pen on handwritten paperwork' },
  { t: 'Revenue pays you directly', d: 'Your refund goes from Revenue into the bank account on your Revenue record, usually within three to five working days of the Statement of Liability. Then we invoice the fee you agreed at the start. No refund, no fee.', p: 'about-euro-coin.jpg', alt: 'Euro coins on a white surface, including an Irish harp one-euro coin' },
];
---
<section class="steps sec" aria-labelledby="steps-h">
  <div class="wrap steps-in">
    <div class="intro">
      <p class="tag rv">How it works</p>
      <h2 id="steps-h" class="split">Four steps. <span class="hl">We do the heavy lifting.</span></h2>
      <p class="lede rv">You spend a few minutes telling us about yourself. We handle Revenue, the paperwork and the follow-up.</p>
      <div class="btns rv">
        <Button href={CTA.href} variant="green">{CTA.label}</Button>
        <Button href="/how-it-works/" variant="ghost">The full process</Button>
      </div>
    </div>

    <ol class="stack-cards">
      {steps.map((s, i) => (
        <li class:list={['stack-card', `c${i}`]}>
          <div class="txt">
            <span class="no">Step {i + 1}<i>/4</i></span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </div>
          <figure class="pic"><img src={`/photos/${s.p}`} alt={s.alt} loading="lazy" /></figure>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps-in{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:clamp(32px,5vw,80px);align-items:start}
  .intro{position:sticky;top:calc(var(--header-h) + 48px)}
  .intro .tag{margin-bottom:var(--s5)}
  h2{margin-bottom:var(--s5)}
  .lede{margin-bottom:var(--s6)}
  .stack-cards{list-style:none;margin:0;padding:0;gap:clamp(20px,4vh,40px)}
  .stack-card{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,.75fr);gap:clamp(18px,2vw,28px);min-height:360px;padding:clamp(22px,2.4vw,32px);border-radius:var(--r-xl);background:#fff;border:1px solid var(--line);box-shadow:0 -10px 40px rgba(20,18,58,.06)}
  .c1{background:var(--indigo-50);border-color:var(--indigo-100)}
  .c2{background:var(--green-50);border-color:var(--green-100)}
  .c3{background:var(--indigo);border-color:var(--indigo);color:var(--on-dark-2)}
  .c3 h3{color:#fff}
  .txt{display:flex;flex-direction:column}
  .no{display:inline-flex;align-items:baseline;gap:2px;font:600 var(--fs-sm)/1 var(--f-display);color:var(--indigo);margin-bottom:auto;padding-bottom:28px}
  .no i{font-style:normal;color:var(--ink-3)}
  .c2 .no{color:var(--green-ink)}
  .c3 .no{color:var(--green-bright)}.c3 .no i{color:var(--on-dark-2)}
  h3{font-size:clamp(1.5rem,1.1rem + 1.3vw,2.25rem);letter-spacing:-.025em;margin-bottom:14px}
  .txt p{margin:0;font-size:var(--fs-sm);line-height:1.6}
  .pic{margin:0;border-radius:var(--r-lg);min-height:100%}
  @media (max-width:1000px){
    .steps-in{grid-template-columns:1fr}
    .intro{position:static}
  }
  @media (max-width:640px){
    .stack-card{grid-template-columns:1fr;min-height:0}
    .pic{aspect-ratio:16/9;min-height:0;order:-1}
    .no{padding-bottom:14px}
  }
</style>
