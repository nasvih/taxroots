---
// The eight services (client PDF, 2026-11-24). Descriptions are the client's wording, verbatim.
// 01 Personal Tax carries the personal reliefs as plain tags (no pages of their own).
import { SERVICES, PERSONAL_TAGS } from '../../data/site';
const [personal, ...rest] = SERVICES;
---
<section class="srv sec bg-2" id="services" aria-labelledby="srv-h">
  <div class="wrap">
    <div class="hd">
      <div>
        <p class="tag rv">Our services</p>
        <h2 id="srv-h" class="split">Personal and business tax, <span class="hl">handled for you</span></h2>
      </div>
      <p class="lede rv" data-delay="120">Personal tax refunds are where most people start with us. We also look after company paperwork, payroll and VAT, and help with mortgages and pensions.</p>
    </div>

    <ol class="grid">
      <li class="cd one rv">
        <span class="no">{personal.no}</span>
        <div class="one-in">
          <div>
            <h3>{personal.title}</h3>
            <p>{personal.desc}</p>
          </div>
          <div class="inc">
            <p class="inc-h">Includes</p>
            <ul class="tags stg" aria-label="Included in personal tax">
              {PERSONAL_TAGS.map((t) => <li>{t}</li>)}
            </ul>
          </div>
        </div>
      </li>
      {rest.map((s, i) => (
        <li class:list={['cd', `k${i + 2}`, 'rv']} data-delay={((i % 3) + 1) * 90}>
          <span class="no">{s.no}</span>
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .hd{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:24px clamp(32px,5vw,80px);align-items:end;margin-bottom:clamp(36px,5vw,64px)}
  .hd .tag{margin-bottom:var(--s5)}
  .hd h2{margin:0;max-width:16ch}
  .hd .lede{margin:0}
  .grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:clamp(14px,1.6vw,20px)}
  .cd{position:relative;display:flex;flex-direction:column;grid-column:span 2;padding:clamp(24px,2.4vw,34px);border-radius:var(--r-xl);background:#fff;border:1px solid var(--line)}
  .cd.k2{grid-column:span 2}
  .no{display:block;margin-bottom:clamp(28px,4vw,56px);font:600 var(--fs-sm)/1 var(--f-display);color:var(--green-ink);letter-spacing:.02em}
  .cd h3{font-size:clamp(1.3rem,1.1rem + .7vw,1.75rem);line-height:1.15;letter-spacing:-.025em;margin-bottom:12px}
  .cd p{margin:0;font-size:var(--fs-sm);line-height:1.6;color:var(--ink-2)}
  .cd.k6,.cd.k7{grid-column:span 3}

  /* 01 Personal Tax: the big one */
  .one{grid-column:span 4}
    .one h3{font-size:clamp(1.7rem,1.2rem + 1.6vw,2.6rem)}
  .one p{font-size:var(--fs-body);max-width:48ch}
  .one-in{display:grid;grid-template-columns:minmax(0,1fr);gap:clamp(24px,3vw,36px);align-content:end;flex:1}
  .inc{padding-top:clamp(20px,2.4vw,28px);border-top:1px solid var(--line)}
  .inc-h{margin:0 0 12px!important;font:600 var(--fs-xs)/1 var(--f-body)!important;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-3)}
  .tags{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:8px}
  .tags li{display:inline-flex;align-items:center;gap:8px;padding:8px 14px 8px 11px;border-radius:var(--r-pill);background:var(--indigo-50);border:1px solid var(--indigo-100);font:500 var(--fs-sm)/1.2 var(--f-display);color:var(--ink)}
  .tags li::before{content:"";width:8px;height:8px;border-radius:2px;background:var(--green);flex:none}

  @media (max-width:1100px){
    .one{grid-column:1/-1}
    .cd,.cd.k2,.cd.k6,.cd.k7{grid-column:span 3}
    .cd.one{grid-column:1/-1}
  }
  @media (max-width:900px){
    .hd{grid-template-columns:1fr}
    .one-in{grid-template-columns:1fr}
  }
  @media (max-width:640px){
    .grid{grid-template-columns:1fr}
    .cd,.cd.k2,.cd.k6,.cd.k7,.one{grid-column:auto}
    .no{margin-bottom:20px}
    .tags li{font-size:var(--fs-xs);padding:7px 12px 7px 10px}
  }
</style>
