<script>
  import { ESTIMATOR, calculate, openYears, euro, freAmount, pick, type YearInput, type Status, type Course } from '../lib/estimator';

  const form = document.getElementById('est') as HTMLFormElement;
  form.hidden = false;
  const ALL: number[] = JSON.parse(form.dataset.years!);
  const OPEN = openYears();
  const CUR = OPEN[OPEN.length - 1] + 1;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const $ = <T extends Element = HTMLElement>(s: string, r: ParentNode = form) => r.querySelector<T>(s)!;
  const $$ = <T extends Element = HTMLElement>(s: string, r: ParentNode = form) => Array.from(r.querySelectorAll<T>(s));
  const KEY = 'tr-estimator-v1';

  // Roll the year list over to the visitor's date (page may have been built last year).
  $$<HTMLElement>('[data-year]').forEach((el) => {
    const y = +el.dataset.year!;
    const open = OPEN.includes(y);
    if (el instanceof HTMLOptionElement) { el.hidden = !open; el.disabled = !open; } else el.hidden = !open;
    const cb = el.querySelector<HTMLInputElement>('input[name=years]');
    if (cb && !open) cb.checked = false;
  });
  const curNote = $('[data-curnote]');
  if (curNote) curNote.textContent = `${CUR} can be claimed during the year in myAccount, or on your ${CUR} return from January ${CUR + 1}.`;

  const num = (v: string | null | undefined) => {
    const x = parseFloat(String(v ?? '').replace(/[€,\s]/g, ''));
    return isFinite(x) && x > 0 ? x : 0;
  };
  const val = (name: string) => (form.elements.namedItem(name) as HTMLInputElement | RadioNodeList | null)?.value ?? '';
  const checked = (name: string) => !!form.querySelector<HTMLInputElement>(`[name="${name}"]:checked`);
  const perYear = (name: string, y: number) => { const v = val(`${name}_${y}`); return v.trim() ? num(v) : num(val(name)); };

  // ---- courses ----
  const coursesBox = $('[data-courses]');
  const tpl = document.getElementById('course-tpl') as HTMLTemplateElement;
  function addCourse(c?: { year?: number; fee?: string; ft?: string }) {
    const node = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
    const sel = node.querySelector<HTMLSelectElement>('[data-c=year]')!;
    Array.from(sel.options).forEach((o) => { const open = OPEN.includes(+o.value); o.hidden = !open; o.disabled = !open; });
    sel.value = String(c?.year && OPEN.includes(c.year) ? c.year : OPEN[OPEN.length - 1]);
    if (c?.fee) node.querySelector<HTMLInputElement>('[data-c=fee]')!.value = c.fee;
    if (c?.ft) node.querySelector<HTMLSelectElement>('[data-c=ft]')!.value = c.ft;
    coursesBox.appendChild(node);
    return node;
  }
  const readCourses = () => $$('.course', coursesBox).map((el) => ({
    year: +el.querySelector<HTMLSelectElement>('[data-c=year]')!.value,
    fee: el.querySelector<HTMLInputElement>('[data-c=fee]')!.value,
    ft: el.querySelector<HTMLSelectElement>('[data-c=ft]')!.value,
  }));
  $('[data-add-course]').addEventListener('click', () => { const n = addCourse(); n.querySelector<HTMLInputElement>('[data-c=fee]')!.focus(); update(); });
  coursesBox.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('[data-rm]'); if (!b) return;
    b.closest('.course')!.remove(); update(); $('[data-add-course]').focus();
  });

  // ---- inputs → model ----
  function selectedYears() { return $$<HTMLInputElement>('input[name=years]:checked').map((i) => +i.value).filter((y) => OPEN.includes(y)).sort(); }
  function inputFor(y: number): YearInput {
    const status = ((val(`status_${y}`) || val('status')) as Status) || 'single';
    const married = status === 'marriedOne' || status === 'marriedTwo';
    const single = !married;
    const incY = val(`income_${y}`).trim() ? num(val(`income_${y}`)) : num(val('income'));
    const courses: Course[] = readCourses().filter((c) => c.year === y).map((c) => ({ fee: num(c.fee), fullTime: c.ft === '1' }));
    return {
      status,
      income: incY || null,
      lowerEarnerIncome: num(val('lower')) || null,
      answer40: (val('answer40') as any) || 'unsure',
      rent: perYear('rent', y),
      rentCouple: married && val('rentCouple') === 'yes',
      medical: perYear('medical', y),
      nursingHome: perYear('nursing', y),
      wfhDays: Math.min(perYear('wfhDays', y), pick(ESTIMATOR.daysInYear, y)),
      wfhBills: perYear('wfhBills', y),
      wfhAllowancePerDay: num(val('wfhAllow')),
      job: val('job'),
      freOnCertificate: (val('freCert') as any) || 'unsure',
      courses,
      homeCarer: married && checked('homeCarer'),
      singleParentCredit: single && checked('spccc'),
      incapacitatedChildren: Math.min(9, Math.floor(num(val('icc')))),
      dependentRelative: checked('dr'),
      age65: checked('age65'),
      taxPaid: num(val(`tax_${y}`)) || null,
    };
  }

  // ---- count-up ----
  const totalEl = $('[data-total]'); const totalM = $('[data-total-m]'); const big = $('.big');
  let shown = 0; let raf = 0;
  const fmt0 = (e: number) => '€' + Math.round(e).toLocaleString('en-IE');
  function animateTo(target: number) {
    cancelAnimationFrame(raf);
    if (reduce) { shown = target; totalEl.textContent = totalM.textContent = fmt0(target); return; }
    const from = shown; const t0 = performance.now(); const dur = Math.min(1400, 500 + Math.abs(target - from) * 0.6);
    if (target > from) { big.classList.remove('pop'); void big.offsetWidth; big.classList.add('pop'); }
    const tick = (t: number) => {
      const k = Math.min(1, (t - t0) / dur); const e = 1 - Math.pow(1 - k, 3);
      shown = from + (target - from) * e;
      totalEl.textContent = totalM.textContent = fmt0(shown);
      if (k < 1) raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);
  }

  // ---- render ----
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  let liveT = 0; let last: ReturnType<typeof calculate> | null = null;
  function update() {
    const status = val('status');
    const married = status === 'marriedOne' || status === 'marriedTwo';
    $$('[data-show]').forEach((el) => {
      const k = el.dataset.show;
      el.hidden = k === 'marriedTwo' ? status !== 'marriedTwo' : k === 'married' ? !married : k === 'noIncome' ? num(val('income')) > 0 : k === 'job' ? !val('job') : false;
    });
    $$('[data-only]').forEach((el) => {
      const k = el.dataset.only; const hide = (k === 'married' && !married) || (k === 'single' && married);
      el.hidden = hide;
    });

    const years = selectedYears();
    const res = calculate(years, inputFor);
    last = res;

    // FRE amount note
    const job = val('job'); const freNote = $('[data-fre-amt]');
    if (job) {
      const f = ESTIMATOR.fre.find((x) => x.id === job)!;
      const ys = years.length ? years : OPEN;
      const amts = Array.from(new Set(ys.map((y) => freAmount(job, y))));
      freNote.textContent = `${f.label}: €${amts.join(' / €')} a year off your taxable income (${ys[0]}${ys.length > 1 ? '–' + ys[ys.length - 1] : ''}).`;
    } else freNote.textContent = '';

    // Tuition note
    const ys = years.length ? years : OPEN;
    const tn = $('[data-tuition-note]');
    const ft = Array.from(new Set(ys.map((y) => pick(ESTIMATOR.tuition.disregardFullTime, y))));
    const pt = Array.from(new Set(ys.map((y) => pick(ESTIMATOR.tuition.disregardPartTime, y))));
    tn.textContent = `Up to €${ESTIMATOR.tuition.maxPerCourse.toLocaleString('en-IE')} of fees per course counts. The first €${ft.map((x) => x.toLocaleString('en-IE')).join(' / €')} (full-time) or €${pt.map((x) => x.toLocaleString('en-IE')).join(' / €')} (part-time) each year doesn’t.` + (ys.some((y) => y >= ESTIMATOR.tuition.announcedFrom) ? ` The ${ESTIMATOR.tuition.announcedFrom}+ figures were announced in Budget ${ESTIMATOR.tuition.announcedFrom + 1}.` : '');

    // Panel
    const euroTotal = res.displayEuro;
    animateTo(euroTotal);
    $('[data-sub]').textContent = years.length ? `across ${years.length} year${years.length > 1 ? 's' : ''} (${years.length > 1 ? years[0] + '–' + years[years.length - 1] : years[0]})` : 'Pick at least one year';
    const byRel = new Map<string, { label: string; cents: number }>();
    res.years.forEach((r) => {
      // scale lines down proportionally when a year is capped
      const k = r.rawCents ? r.estimateCents / r.rawCents : 0;
      r.lines.forEach((l) => { const key = l.key === 'spcccBand' ? 'spccc' : l.key; const cur = byRel.get(key) || { label: key === 'spccc' ? 'Single Person Child Carer Credit' : l.label, cents: 0 }; cur.cents += l.cents * k; byRel.set(key, cur); });
    });
    const rel = Array.from(byRel.values()).filter((r) => r.cents >= 1).sort((a, b) => b.cents - a.cents);
    const max = Math.max(1, ...rel.map((r) => r.cents));
    $('[data-rel]').innerHTML = rel.map((r) => `<li><span>${esc(r.label)}</span><b>${euro(Math.round(r.cents), 0)}</b><i style="--w:${(r.cents / max).toFixed(3)}"></i></li>`).join('');
    $('[data-empty]').hidden = rel.length > 0;
    clearTimeout(liveT);
    liveT = window.setTimeout(() => { $('[data-live]').textContent = `Estimate: around ${fmt0(euroTotal)} across ${years.length} years.`; }, 900);

    // Result step
    $('[data-headline]').innerHTML = res.totalCents > 0
      ? `You could be owed around <span class="hl">${fmt0(euroTotal)}</span> across ${years.length} year${years.length > 1 ? 's' : ''}.`
      : 'Your estimate';
    $('[data-zero]').hidden = res.totalCents > 0;
    $('[data-years-out]').innerHTML = res.years.map((r) => `
      <div class="yr"><div class="yr-h"><h3>${r.year}</h3><strong>${euro(r.estimateCents)}</strong></div>
      ${r.lines.length ? `<ul>${r.lines.map((l) => `<li><span>${esc(l.label)}</span><span>${euro(l.cents)}</span></li>`).join('')}</ul>` : '<p class="none">Nothing estimated for this year from your answers.</p>'}
      ${r.capped ? `<p class="capn">Capped at the income tax we think you paid (${euro(r.capCents!)}), because credits can’t be more than that.</p>` : ''}
      <p class="capn">Worked out at ${Math.round(r.rate * 100)}% for reliefs given at your tax rate.</p></div>`).join('')
      + `<div class="yr cur"><div class="yr-h"><h3>${CUR}</h3></div><p class="none">Not included. You can claim ${CUR} credits during the year in myAccount, or on your ${CUR} return from January ${CUR + 1}. We can help with that too.</p></div>`;
    $('[data-couple-note]').hidden = !res.coupleUncapped;
    const feeEl = $('[data-fee]');
    if (ESTIMATOR.feePercent != null && res.totalCents > 0) {
      const feeE = Math.round(euroTotal * ESTIMATOR.feePercent) / 100;
      feeEl.textContent = `Our fee (${ESTIMATOR.feePercent}%${ESTIMATOR.feeVat ? ' + VAT' : ''}): €${feeE.toLocaleString('en-IE')} · You’d keep: €${(euroTotal - feeE).toLocaleString('en-IE')}. No refund, no fee.`;
      feeEl.hidden = false;
    } else feeEl.hidden = true;

    save();
  }

  // ---- hand-off to /start ----
  function handoff() {
    const years = selectedYears();
    const y0 = years.length ? years : OPEN;
    const data: Record<string, any> = {
      total: last?.displayEuro ?? 0, years: y0, status: val('status'), job: val('job'),
      jobLabel: ESTIMATOR.fre.find((f) => f.id === val('job'))?.label || '',
      emergencyTax: checked('emerg'), outOfWork: checked('outOfWork'), leftIreland: checked('leftIE'), married: checked('married'),
      singleParent: checked('spccc') || val('status') === 'singleParent', incapacitatedChild: num(val('icc')) > 0, relative: checked('dr'), age65: checked('age65'),
      costs: Object.fromEntries(y0.map((y) => {
        const i = inputFor(y);
        const tu = (i.courses || []).reduce((s, c) => s + c.fee, 0);
        return [y, { rent: i.rent, medical: i.medical, nursing: i.nursingHome, wfhDays: i.wfhDays, wfhBills: i.wfhBills, tuition: tu, tuitionType: (i.courses || []).some((c) => c.fullTime) ? 'full-time' : (i.courses || []).length ? 'part-time' : '' }];
      })),
    };
    try { sessionStorage.setItem('tr-estimate', JSON.stringify(data)); } catch {}
    const q = new URLSearchParams({ from: 'estimator', est: String(data.total), years: y0.join(','), status: data.status });
    if (data.job) q.set('job', data.job);
    return `/start/?${q}`;
  }
  $$<HTMLAnchorElement>('[data-cta]').forEach((a) => a.addEventListener('click', () => { a.href = handoff(); }));

  // ---- persistence (session only) ----
  function save() {
    const o: Record<string, any> = {};
    $$<HTMLInputElement>('input[name],select[name]').forEach((el) => {
      if (el.type === 'checkbox') { if (el.name === 'years') (o.years ||= []).push(...(el.checked ? [el.value] : [])); else o[el.name] = el.checked; }
      else if (el.type === 'radio') { if (el.checked) o[el.name] = el.value; }
      else o[el.name] = el.value;
    });
    o.__courses = readCourses();
    try { sessionStorage.setItem(KEY, JSON.stringify(o)); } catch {}
  }
  function restore() {
    let o: any; try { o = JSON.parse(sessionStorage.getItem(KEY) || 'null'); } catch {}
    if (!o) return;
    $$<HTMLInputElement>('input[name],select[name]').forEach((el) => {
      if (el.name === 'years') { if (Array.isArray(o.years)) el.checked = o.years.includes(el.value) && OPEN.includes(+el.value); }
      else if (el.type === 'checkbox') el.checked = !!o[el.name];
      else if (el.type === 'radio') { if (o[el.name] != null) el.checked = o[el.name] === el.value; }
      else if (o[el.name] != null) el.value = o[el.name];
    });
    (o.__courses || []).forEach((c: any) => addCourse(c));
  }

  // ---- stepper ----
  const panes = $$('[data-pane]');
  const tabs = $$<HTMLButtonElement>('.st');
  const prev = $<HTMLButtonElement>('[data-prev]'); const next = $<HTMLButtonElement>('[data-next]');
  const mbar = $('[data-mbar]');
  let cur = 0;
  function go(i: number, focus = true) {
    i = Math.max(0, Math.min(panes.length - 1, i));
    const back = i < cur;
    panes.forEach((p, k) => { p.hidden = k !== i; p.classList.remove('enter', 'back'); });
    const p = panes[i];
    if (!reduce) { void p.offsetWidth; p.classList.add('enter'); if (back) p.classList.add('back'); }
    tabs.forEach((t, k) => { if (k === i) t.setAttribute('aria-current', 'step'); else t.removeAttribute('aria-current'); t.classList.toggle('done', k < i); });
    $('.bar i').style.setProperty('--p', String((i + 1) / panes.length));
    prev.disabled = i === 0;
    next.hidden = i === panes.length - 1;
    (next.querySelector('span') as HTMLElement).textContent = i === panes.length - 2 ? 'See my estimate' : 'Next';
    cur = i;
    syncBar();
    tabs[i].scrollIntoView({ block: 'nearest', inline: 'center', behavior: reduce ? 'auto' : 'smooth' });
    if (focus) {
      const top = form.getBoundingClientRect().top;
      if (top < 0 || top > innerHeight * 0.5) {
        const lenis = (window as any).__lenis;
        if (lenis) lenis.scrollTo(form, { offset: -96 }); else form.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' });
      }
      p.querySelector<HTMLElement>('h2')?.focus({ preventScroll: true });
    }
  }
  form.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('[data-go]');
    if (t) go(+t.dataset.go!);
  });
  prev.addEventListener('click', () => go(cur - 1));
  next.addEventListener('click', () => go(cur + 1));
  form.addEventListener('submit', (e) => { e.preventDefault(); go(cur + 1); });
  form.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && (e.target as HTMLElement).matches('input:not([type=checkbox]):not([type=radio])')) { e.preventDefault(); go(cur + 1); }
  });
  form.addEventListener('input', update);
  form.addEventListener('change', update);

  // mobile bar: shown while the steps are on screen, hidden when the real panel is visible or on the result step
  let inTool = false; let panelVis = false; let navVis = false;
  const syncBar = () => mbar.classList.toggle('off', !inTool || panelVis || navVis || cur === panes.length - 1);
  new IntersectionObserver(([en]) => { navVis = en.isIntersecting; syncBar(); }).observe($('.nav-btns'));
  new IntersectionObserver(([en]) => { panelVis = en.isIntersecting; syncBar(); }).observe($('.panel'));
  new IntersectionObserver(([en]) => { inTool = en.isIntersecting; syncBar(); }, { rootMargin: '-20% 0px -20% 0px' }).observe($('.main'));

  restore();
  update();
  go(0, false);
</script>
