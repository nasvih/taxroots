---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import Pic from '../components/Pic.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { CTA } from '../data/site';
import { ESTIMATOR, openYears, deadlineBanner, pick } from '../lib/estimator';

const now = new Date();
const OPEN = openYears(now);
// Render one extra (current) year so the page rolls over on 1 January without a rebuild;
// the client script shows only the years that are open on the visitor's date.
const YEARS = [...OPEN, OPEN[OPEN.length - 1] + 1];
const CUR = YEARS[YEARS.length - 1];
const banner = deadlineBanner(now);
const range = `${OPEN[0]}–${OPEN[OPEN.length - 1]}`;
const fmtDate = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString('en-IE', { day: 'numeric', month: 'long', year: 'numeric' });

const DISCLAIMER = "Estimate only. This is a rough guide based on what you've told us and Revenue's published rates. It isn't tax advice or a guarantee. Your actual refund depends on your full tax record and Revenue's review.";

const STEPS = [
  { id: 'you', label: 'You' },
  { id: 'rent', label: 'Rent' },
  { id: 'health', label: 'Health' },
  { id: 'wfh', label: 'Home working' },
  { id: 'job', label: 'Your job' },
  { id: 'college', label: 'College' },
  { id: 'family', label: 'Family & more' },
  { id: 'result', label: 'Your estimate' },
];

type Money = { id: string; step: string; label: string; hint?: string; unit?: string; placeholder?: string };
const MONEY: Money[] = [
  { id: 'income', step: 'you', label: 'Roughly what do you earn before tax each year?', hint: 'Optional. For couples, add both incomes together. It helps us pick your tax rate and keep the estimate realistic.', placeholder: 'e.g. 40,000' },
  { id: 'rent', step: 'rent', label: 'Rent paid in a year', hint: 'Rent for your own home, a place you rent to get to work or college, or your child’s college accommodation. Leave out bills, meals and other charges.', placeholder: 'e.g. 12,000' },
  { id: 'medical', step: 'health', label: 'Medical and non-routine dental costs', hint: 'What you paid that insurance, the HSE or anyone else didn’t pay back.', placeholder: 'e.g. 800' },
  { id: 'nursing', step: 'health', label: 'Nursing home fees you paid', hint: 'Only your share, not the HSE’s Fair Deal part. Leave blank if none.', placeholder: 'e.g. 0' },
  { id: 'wfhDays', step: 'wfh', label: 'Days you worked from home', unit: 'days', hint: 'Full working days at home. Not weekends, annual leave or evenings.', placeholder: 'e.g. 100' },
  { id: 'wfhBills', step: 'wfh', label: 'Your share of electricity, heating and broadband', hint: 'The full year’s bills, or just the part you paid if you split them.', placeholder: 'e.g. 2,000' },
  { id: 'wfhAllow', step: 'wfh', label: 'Remote working allowance from your employer, per day', hint: `Employers can pay up to €${ESTIMATOR.remoteWorking.employerTaxFreePerDay.toFixed(2)} a day tax-free. Leave blank if they pay nothing.`, placeholder: 'e.g. 0', },
];
const moneyFor = (step: string) => MONEY.filter((m) => m.step === step);

const STATUS = [
  { v: 'single', t: 'Single', d: 'Including widowed or separated' },
  { v: 'singleParent', t: 'Single parent', d: 'Single, with a child living with you' },
  { v: 'marriedOne', t: 'Married, one income', d: 'Or civil partners, one of you earns' },
  { v: 'marriedTwo', t: 'Married, two incomes', d: 'Or civil partners, you both earn' },
];

const OTHER = [
  { id: 'homeCarer', label: 'Home Carer Tax Credit', d: 'Married or civil partners, jointly assessed, with one of you caring for a child, someone 65+ or someone incapacitated at home.', href: '/services/home-carer-tax-credit/', show: 'married' },
  { id: 'spccc', label: 'Single Person Child Carer Credit', d: 'You’re single and a child lives with you for most of the year. Only one parent can claim.', href: '/services/single-parent-credit/', show: 'single' },
  { id: 'dr', label: 'Dependent Relative Tax Credit', d: 'You support a relative who can’t support themselves because of age or illness, or a widowed parent.', href: '/services/dependent-relative-age-credits/', show: 'all' },
  { id: 'age65', label: 'Age Tax Credit', d: 'You (or your spouse or civil partner) were 65 or over in that year.', href: '/services/dependent-relative-age-credits/', show: 'all' },
];

const faq = [
  { q: 'How accurate is this estimate?', a: 'It uses Revenue’s published rates and caps for each year, but it only knows what you tell it. We confirm the real figure after checking your Revenue record, and a full review can find more (or occasionally show tax owed).' },
  { q: 'Why isn’t emergency tax or USC included?', a: 'Emergency tax, USC (Universal Social Charge) overpayments and year-of-marriage refunds depend on your payslips and Revenue record, so a quick tool can’t estimate them. We check all of them in a full review.' },
  { q: `Why can’t I pick ${CUR}?`, a: `You can claim credits for ${CUR} during the year through myAccount, or on your ${CUR} return from January ${CUR + 1}. This estimator looks at the four closed years Revenue can still repay: ${range}.` },
  { q: 'Do I need receipts?', a: 'For rent and health expenses, yes: keep your records for six years. Flat Rate Expenses don’t need receipts.' },
  { q: 'Is anything I type here sent to you?', a: 'No. The estimate is worked out in your browser. Nothing is sent unless you choose to start a claim.' },
];
---
<Base
  title={`Tax refund estimator, ${range}`}
  description="Estimate your Irish tax refund in two minutes: rent, medical bills, working from home, flat rate expenses and college fees, using Revenue's published rates."
>
  <PageHero
    title="See what Revenue could owe you."
    tag="Refund estimator"
    lede={`Answer a few friendly questions about ${range}. We’ll add up the credits and reliefs you may have missed, year by year, using Revenue’s published rates.`}
    crumbs={[{ label: 'Refund estimator' }]}
  >
    <ul class="hero-points">
      <li>About two minutes</li><li>Nothing is sent to us</li><li>Rates last checked {fmtDate(ESTIMATOR.lastChecked)}</li>
    </ul>
  </PageHero>

  <section class="tool-sec bg-2" id="estimator" aria-label="Refund estimator">
    <div class="wrap">
      {banner && (
        <p class="deadline" data-deadline><strong>{banner.year} refunds close on {fmtDate(banner.date)}.</strong> After that, Revenue can’t repay {banner.year}.</p>
      )}
      <p class="disc-top"><strong>Estimate only.</strong> {DISCLAIMER.replace('Estimate only. ', '')}</p>

      <noscript>
        <div class="nojs card">
          <h2>The estimator needs JavaScript</h2>
          <p>It works everything out in your browser, so it can’t run with JavaScript switched off. You can still start a claim and we’ll check every credit and relief for you.</p>
          <a class="link" href={CTA.href}>{CTA.label}</a>
        </div>
      </noscript>

      <form class="tool" id="est" hidden novalidate aria-describedby="est-help" data-years={JSON.stringify(YEARS)} data-cur={CUR}>
        <p id="est-help" class="sr-only">Eight short steps. Your estimate updates as you type.</p>
        <div class="main">
          <nav class="steps" aria-label="Estimator steps">
            <ol>
              {STEPS.map((s, i) => (
                <li><button type="button" class="st" data-go={i} aria-current={i === 0 ? 'step' : undefined}><span class="n">{i + 1}</span><span class="t">{s.label}</span></button></li>
              ))}
            </ol>
            <div class="bar" aria-hidden="true"><i></i></div>
          </nav>

          <div class="panes">
            <!-- 1. You -->
            <section class="pane" data-pane="0" aria-labelledby="h-you">
              <p class="kick">Step 1 of 8</p>
              <h2 id="h-you" tabindex="-1">Which years, and a little about you</h2>
              <fieldset class="grp">
                <legend>Years to check</legend>
                <div class="chips">
                  {YEARS.map((y) => (
                    <label class="chip" data-year={y} hidden={!OPEN.includes(y)}><input type="checkbox" name="years" value={y} checked={OPEN.includes(y)} /><span>{y}</span></label>
                  ))}
                </div>
                <p class="hint">Revenue can repay the last four closed years. <span data-curnote>{CUR} can be claimed during the year in myAccount, or on your {CUR} return from January {CUR + 1}.</span></p>
              </fieldset>

              <fieldset class="grp">
                <legend>Your situation</legend>
                <div class="cards">
                  {STATUS.map((s, i) => (
                    <label class="opt"><input type="radio" name="status" value={s.v} checked={i === 0} /><span><strong>{s.t}</strong><small>{s.d}</small></span></label>
                  ))}
                </div>
              </fieldset>

              {moneyFor('you').map((m) => (
                <div class="field money" data-money={m.id}>
                  <label for={`f-${m.id}`}>{m.label}</label>
                  <div class="eur"><span aria-hidden="true">€</span><input id={`f-${m.id}`} name={m.id} inputmode="decimal" autocomplete="off" placeholder={m.placeholder} aria-describedby={`f-${m.id}-h`} /></div>
                  <p class="hint" id={`f-${m.id}-h`}>{m.hint}</p>
                </div>
              ))}

              <div class="field money" data-show="marriedTwo" hidden>
                <label for="f-lower">And the lower earner’s yearly income?</label>
                <div class="eur"><span aria-hidden="true">€</span><input id="f-lower" name="lower" inputmode="decimal" autocomplete="off" placeholder="e.g. 25,000" /></div>
                <p class="hint">Two-income couples get a bigger 20% band, up to the lower earner’s income.</p>
              </div>

              <fieldset class="grp" data-show="noIncome">
                <legend>Do you pay tax at 40% on any of your income?</legend>
                <div class="seg">
                  <label><input type="radio" name="answer40" value="yes" /><span>Yes</span></label>
                  <label><input type="radio" name="answer40" value="no" /><span>No</span></label>
                  <label><input type="radio" name="answer40" value="unsure" checked /><span>Not sure</span></label>
                </div>
                <p class="hint">Not sure? We’ll assume 20%, which keeps the estimate on the cautious side.</p>
              </fieldset>

              <details class="py">
                <summary>Did your situation change between years?</summary>
                <div class="py-body">
                  <p class="hint">Only fill in what was different. Anything blank uses your answers above.</p>
                  <div class="py-table">
                    {YEARS.map((y) => (
                      <div class="py-row" data-year={y} hidden={!OPEN.includes(y)}>
                        <strong>{y}</strong>
                        <label><span>Situation</span>
                          <select name={`status_${y}`}><option value="">Same as above</option>{STATUS.map((s) => <option value={s.v}>{s.t}</option>)}</select>
                        </label>
                        <label><span>Income</span><input name={`income_${y}`} inputmode="decimal" placeholder="€" autocomplete="off" /></label>
                        <label><span>Income tax paid <em>(if you know it)</em></span><input name={`tax_${y}`} inputmode="decimal" placeholder="€" autocomplete="off" /></label>
                      </div>
                    ))}
                  </div>
                </div>
              </details>
            </section>

            <!-- 2. Rent -->
            <section class="pane" data-pane="1" aria-labelledby="h-rent" hidden>
              <p class="kick">Step 2 of 8</p>
              <h2 id="h-rent" tabindex="-1">Did you pay rent?</h2>
              <p class="intro">The Rent Tax Credit gives back 20% of the rent you paid, up to a yearly maximum. Parents paying for a student’s college accommodation can often claim it too.</p>
              <div class="field money" data-money="rent">
                <label for="f-rent">{MONEY[1].label}</label>
                <div class="eur"><span aria-hidden="true">€</span><input id="f-rent" name="rent" inputmode="decimal" autocomplete="off" placeholder={MONEY[1].placeholder} aria-describedby="f-rent-h" /></div>
                <p class="hint" id="f-rent-h">{MONEY[1].hint}</p>
                <details class="py"><summary>Different each year?</summary><div class="py-grid">{YEARS.map((y) => <label data-year={y} hidden={!OPEN.includes(y)}><span>{y}</span><input name={`rent_${y}`} inputmode="decimal" placeholder="€" autocomplete="off" /></label>)}</div></details>
              </div>
              <fieldset class="grp" data-show="married" hidden>
                <legend>Are you jointly assessed as a couple?</legend>
                <div class="seg">
                  <label><input type="radio" name="rentCouple" value="yes" checked /><span>Yes</span></label>
                  <label><input type="radio" name="rentCouple" value="no" /><span>No</span></label>
                </div>
                <p class="hint">Jointly assessed couples share a higher yearly maximum.</p>
              </fieldset>
              <aside class="mini-note">
                <strong>Yearly maximum</strong>
                <ul class="caps">{OPEN.map((y) => <li><span>{y}</span> €{pick(ESTIMATOR.rentCap.single, y).toLocaleString('en-IE')} single · €{pick(ESTIMATOR.rentCap.couple, y).toLocaleString('en-IE')} couple</li>)}</ul>
                <p>You can’t claim if you get HAP, Rent Supplement or RAS, or rent from a housing association, or from a relative.</p>
              </aside>
            </section>

            <!-- 3. Health -->
            <section class="pane" data-pane="2" aria-labelledby="h-health" hidden>
              <p class="kick">Step 3 of 8</p>
              <h2 id="h-health" tabindex="-1">Doctors, dentists and prescriptions</h2>
              <p class="intro">You get 20% back on qualifying health costs you paid for yourself or anyone else. Nursing home fees get relief at your highest rate.</p>
              {moneyFor('health').map((m) => (
                <div class="field money" data-money={m.id}>
                  <label for={`f-${m.id}`}>{m.label}</label>
                  <div class="eur"><span aria-hidden="true">€</span><input id={`f-${m.id}`} name={m.id} inputmode="decimal" autocomplete="off" placeholder={m.placeholder} aria-describedby={`f-${m.id}-h`} /></div>
                  <p class="hint" id={`f-${m.id}-h`}>{m.hint}</p>
                  <details class="py"><summary>Different each year?</summary><div class="py-grid">{YEARS.map((y) => <label data-year={y} hidden={!OPEN.includes(y)}><span>{y}</span><input name={`${m.id}_${y}`} inputmode="decimal" placeholder="€" autocomplete="off" /></label>)}</div></details>
                </div>
              ))}
              <div class="two-col">
                <div><strong class="ok">Usually counts</strong><ul class="ticks"><li>GP and consultant fees</li><li>Prescriptions</li><li>Physio when referred</li><li>Crowns, root canals, braces</li><li>Hearing aids, IVF</li></ul></div>
                <div><strong class="no">Doesn’t count</strong><ul class="ticks x"><li>Fillings, cleaning, extractions</li><li>Routine eye tests</li><li>Cosmetic treatment</li><li>Anything paid back to you</li></ul></div>
              </div>
            </section>

            <!-- 4. WFH -->
            <section class="pane" data-pane="3" aria-labelledby="h-wfh" hidden>
              <p class="kick">Step 4 of 8</p>
              <h2 id="h-wfh" tabindex="-1">Did you work from home?</h2>
              <p class="intro">Remote Working Relief covers 30% of your electricity, heating and broadband for the days you worked from home, less any allowance your employer paid.</p>
              {moneyFor('wfh').map((m) => (
                <div class="field money" data-money={m.id}>
                  <label for={`f-${m.id}`}>{m.label}</label>
                  <div class:list={['eur', { days: m.unit }]}>{!m.unit && <span aria-hidden="true">€</span>}<input id={`f-${m.id}`} name={m.id} inputmode={m.unit ? 'numeric' : 'decimal'} autocomplete="off" placeholder={m.placeholder} aria-describedby={`f-${m.id}-h`} />{m.unit && <span class="unit" aria-hidden="true">{m.unit}</span>}</div>
                  <p class="hint" id={`f-${m.id}-h`}>{m.hint}</p>
                  {m.id !== 'wfhAllow' && <details class="py"><summary>Different each year?</summary><div class="py-grid">{YEARS.map((y) => <label data-year={y} hidden={!OPEN.includes(y)}><span>{y}</span><input name={`${m.id}_${y}`} inputmode="decimal" placeholder={m.unit ? 'days' : '€'} autocomplete="off" /></label>)}</div></details>}
                </div>
              ))}
            </section>

            <!-- 5. Job -->
            <section class="pane" data-pane="4" aria-labelledby="h-job" hidden>
              <p class="kick">Step 5 of 8</p>
              <h2 id="h-job" tabindex="-1">What do you do for work?</h2>
              <p class="intro">Many jobs have a Flat Rate Expense agreed with Revenue, for things like uniforms, tools or registration fees. It comes off your taxable income every year, and you don’t need receipts.</p>
              <div class="field">
                <label for="f-job">Your job</label>
                <select id="f-job" name="job">
                  <option value="">Other / not listed</option>
                  {ESTIMATOR.fre.map((f) => <option value={f.id}>{f.label}</option>)}
                </select>
                <p class="hint">Not on the list? There are many more on Revenue’s list. We check your exact role when we review your claim.</p>
              </div>
              <fieldset class="grp" data-show="job" hidden>
                <legend>Is this already on your Tax Credit Certificate?</legend>
                <div class="seg">
                  <label><input type="radio" name="freCert" value="no" /><span>No</span></label>
                  <label><input type="radio" name="freCert" value="yes" /><span>Yes</span></label>
                  <label><input type="radio" name="freCert" value="unsure" checked /><span>Not sure</span></label>
                </div>
                <p class="hint">If it’s already there, you’re getting it, so we leave it out.</p>
              </fieldset>
              <p class="fre-amt" data-fre-amt aria-live="polite"></p>
            </section>

            <!-- 6. College -->
            <section class="pane" data-pane="5" aria-labelledby="h-college" hidden>
              <p class="kick">Step 6 of 8</p>
              <h2 id="h-college" tabindex="-1">Did you pay college fees?</h2>
              <p class="intro">Tuition fees relief gives 20% back on approved third-level courses, for you or anyone you paid for. The first part of the fees in each year doesn’t count, so a student contribution on its own usually gets nothing back.</p>
              <div class="courses" data-courses></div>
              <button type="button" class="add" data-add-course><span aria-hidden="true">+</span> Add a course</button>
              <p class="hint" data-tuition-note></p>
              <template id="course-tpl">
                <div class="course">
                  <label><span>Year paid</span><select data-c="year">{YEARS.map((y) => <option value={y} data-year={y} hidden={!OPEN.includes(y)}>{y}</option>)}</select></label>
                  <label><span>Fees you paid</span><span class="eur sm"><span aria-hidden="true">€</span><input data-c="fee" inputmode="decimal" placeholder="e.g. 8,500" autocomplete="off" /></span></label>
                  <label><span>Course type</span><select data-c="ft"><option value="1">Full-time</option><option value="0">Part-time</option></select></label>
                  <button type="button" class="rm" data-rm aria-label="Remove this course">Remove</button>
                </div>
              </template>
            </section>

            <!-- 7. Family & more -->
            <section class="pane" data-pane="6" aria-labelledby="h-family" hidden>
              <p class="kick">Step 7 of 8</p>
              <h2 id="h-family" tabindex="-1">Family, and anything else that happened</h2>
              <fieldset class="grp">
                <legend>Credits you think you might have missed</legend>
                <div class="checkcards">
                  {OTHER.map((o) => (
                    <label class="opt chk" data-only={o.show}><input type="checkbox" name={o.id} value="yes" /><span><strong>{o.label}</strong><small>{o.d} <a href={o.href} target="_blank" rel="noopener">Conditions apply</a></small></span></label>
                  ))}
                  <div class="count">
                    <span><strong id="icc-l">Incapacitated Child Tax Credit</strong><small>A child with a lasting physical or mental incapacity. <a href="/services/incapacitated-child-credit/" target="_blank" rel="noopener">Conditions apply</a></small></span>
                    <label class="cnt"><span>Children</span><input type="number" name="icc" min="0" max="9" step="1" value="0" inputmode="numeric" aria-labelledby="icc-l" /></label>
                  </div>
                </div>
                <p class="hint">We count these for every year you picked. We check each year properly when we review your record.</p>
              </fieldset>
              <fieldset class="grp">
                <legend>Did any of these happen since {OPEN[0]}? <span class="opt-l">(we can’t estimate them, but we check them)</span></legend>
                <div class="checkcards slim">
                  <label class="opt chk"><input type="checkbox" name="emerg" value="yes" /><span><strong>Emergency tax, or a new job</strong></span></label>
                  <label class="opt chk"><input type="checkbox" name="outOfWork" value="yes" /><span><strong>Time out of work</strong></span></label>
                  <label class="opt chk"><input type="checkbox" name="leftIE" value="yes" /><span><strong>Left Ireland, or leaving soon</strong></span></label>
                  <label class="opt chk"><input type="checkbox" name="married" value="yes" /><span><strong>Got married or entered a civil partnership</strong></span></label>
                </div>
              </fieldset>
            </section>

            <!-- 8. Result -->
            <section class="pane res-pane" data-pane="7" aria-labelledby="h-result" hidden>
              <p class="kick">Step 8 of 8</p>
              <h2 id="h-result" tabindex="-1" data-headline>Your estimate</h2>
              <p class="disc-in">{DISCLAIMER}</p>
              <div class="years" data-years-out></div>
              <p class="zero" data-zero hidden>We couldn’t estimate a refund from these answers, but there may be things this tool can’t see, like emergency tax or USC (Universal Social Charge). Want us to take a proper look? No refund, no fee.</p>
              <p class="fee" data-fee hidden></p>
              <h3 class="cav-h">Good to know</h3>
              <ul class="cav">
                <li>Credits can’t be more than the income tax you paid in a year, so we cap each year where we can.</li>
                <li>Rent and health relief need records. Keep receipts for six years.</li>
                <li>Emergency tax, USC and year-of-marriage refunds aren’t estimated here, but we check them.</li>
                <li>A review can sometimes show tax owed. If it does, we tell you before anything is filed.</li>
                <li data-couple-note hidden>For couples we can’t cap the estimate without your tax figures, so it may be on the high side.</li>
              </ul>
              <p class="confirm">We’ll confirm the real figure after checking your Revenue record.</p>
              <div class="btns">
                <Button href={CTA.href} variant="green" data-cta>{CTA.label}</Button>
                <button type="button" class="btn ghost plain" data-go="0">Change my answers</button>
              </div>
            </section>
          </div>

          <div class="nav-btns">
            <button type="button" class="btn ghost plain" data-prev disabled>Back</button>
            <Button data-next variant="">Next</Button>
          </div>
        </div>

        <aside class="panel" aria-labelledby="p-h">
          <div class="panel-in">
            <p class="p-label" id="p-h">You could be owed around</p>
            <p class="big" aria-hidden="true"><span data-total>€0</span></p>
            <p class="sr-only" aria-live="polite" data-live></p>
            <p class="p-sub" data-sub>across 4 years</p>
            <ul class="rel" data-rel></ul>
            <p class="p-empty" data-empty>Start answering and your estimate builds here.</p>
            <p class="p-disc">{DISCLAIMER}</p>
            <a class="btn green p-cta" href={CTA.href} data-cta><span>{CTA.label}</span><span class="disc"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a>
          </div>
        </aside>

        <div class="mbar off" data-mbar aria-hidden="true">
          <div><small>Estimate</small><strong data-total-m>€0</strong></div>
          <button type="button" class="btn white sm plain" data-go="7" tabindex="-1">See breakdown</button>
        </div>
      </form>
    </div>
  </section>

  <section class="sec how">
    <div class="wrap how-in">
      <div>
        <h2 class="split">What the estimator counts, and what it can’t see</h2>
        <p class="lede rv">It uses each year’s published rates: the Rent Tax Credit at 20% up to the yearly maximum, health expenses at 20%, Remote Working Relief and Flat Rate Expenses at your tax rate, tuition fees at 20% after the yearly disregard, and the main family credits.</p>
        <p class="rv">A full review goes further. We look at your actual Revenue record for every open year, including emergency tax, USC, joint assessment in the year you married and any jobs that overlapped.</p>
        <div class="btns rv"><Button href="/how-it-works/" variant="ghost">How a claim works</Button></div>
      </div>
      <Pic src="hero-woman-smiling-phone.jpg" alt="Young woman in glasses smiling as she reads good news on her phone" ratio="4/5" />
    </div>
  </section>

  <section class="sec-s bg-2">
    <div class="wrap faq-wrap">
      <h2 class="split">Estimator questions</h2>
      <Faq items={faq} />
    </div>
